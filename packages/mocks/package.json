{
  "name": "@atm/mocks",
  "version": "0.1.0",
  "private": true,
  "description": "Fake TestRail and Allure TestOps servers for local development and end-to-end tests",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "fastify": "^5.12.5"
  }
}
